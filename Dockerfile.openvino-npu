FROM python:3.11-slim

# Instalar dependencias del sistema para OpenVINO NPU
# libusb y udev necesarios para acceso al dispositivo NPU (/dev/accel0)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0 udev procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalar dependencias Python
# openvino>=2024.1 incluye soporte NPU (Meteor Lake)
# optimum-intel para OVModelForFeatureExtraction
# transformers para tokenizer
# fastapi + uvicorn para el servidor
RUN pip install --no-cache-dir \
    "openvino>=2024.1" \
    "optimum[intel]>=1.20" \
    "transformers>=4.40" \
    "torch>=2.2" \
    "fastapi>=0.100" \
    "uvicorn[standard]>=0.20" \
    "numpy<2"

# Copiar el script del servidor
COPY openvino-npu-embeddings.py /app/openvino-npu-embeddings.py

ENV OPENVINO_DEVICE=NPU
ENV EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENV PORT=8283
ENV PYTHONUNBUFFERED=1

EXPOSE 8283

CMD ["python", "/app/openvino-npu-embeddings.py"]