networks:
  ia-routing-stack:
    driver: bridge
volumes:
  openvino-models: null
  ov_cache: null
  lms-config: null
  open-webui-data: null
  open-terminal-data: null
services:
  # ==========================================
  # SECCIÓN MCP (Model Context Protocol Servers)
  # Transporte: streamable-http (compatible nativo con Open WebUI >= 0.11)
  # ==========================================

  # Open Terminal - servidor REST oficial de open-webui/open-terminal
  # Integracion nativa en Open WebUI (Admin Settings -> Integrations -> Open Terminal)
  # Da barra lateral con file browser, upload/download, editor y ejecucion de comandos
  open-terminal:
    image: ghcr.io/open-webui/open-terminal:slim
    container_name: open-terminal
    restart: unless-stopped
    ports:
      - "8003:8000"
    environment:
      - OPEN_TERMINAL_API_KEY=XMaT-ey_ekoJ9zHJITPpNQilqi_o9Sqy7G4q0jo1gyE
      - OPEN_TERMINAL_FILE_BROWSER_ROOT=/workspace
    volumes:
      - open-terminal-data:/home/user
      - /home/arkantu/workspace:/workspace
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  fetch-mcp:
    build:
      context: ./mcp-servers/fetch-mcp
      dockerfile: Dockerfile
    image: fetch-mcp:latest
    container_name: fetch-mcp
    restart: unless-stopped
    ports:
      - "8095:8095"
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # SearXNG - metabuscador (backend de busqueda para searxng-mcp y para el
  # backend `searxng` de Hermes en config.yaml). Puerto host 8085 -> 8080.
  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    restart: unless-stopped
    ports:
      - "8085:8080"
    volumes:
      - ./searxng/settings.yml:/etc/searxng/settings.yml:ro
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # MCP server de busqueda web (tool `search_web`). Usa SearXNG interno y
  # cae a DDGS si SearXNG no responde. Transporte SSE en /sse (patron
  # consumido por LM Studio y por mcp-bridge/oi_mcp_proxy.py).
  searxng-mcp:
    build:
      context: ./mcp-servers/searxng-mcp
      dockerfile: Dockerfile
    image: searxng-mcp:latest
    container_name: searxng-mcp
    restart: unless-stopped
    ports:
      - "8092:8092"
    environment:
      - SEARXNG_URL=http://searxng:8080
    depends_on:
      - searxng
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  nano-fs-tools-mcp:
    build:
      context: ./mcp-servers/nano-fs-tools-mcp
      dockerfile: Dockerfile
    image: nano-fs-tools-mcp:latest
    container_name: nano-fs-tools-mcp
    restart: unless-stopped
    ports:
      - "8096:8096"
    volumes:
      - /home/arkantu/workspace:/workspace
    environment:
      - WORKSPACE_DIR=/workspace
      - OPENVINO_GENAI_URL=http://ia-gpu-intel-openvino:8000/v1
      - INTEL_OPENVINO_URL=http://ia-gpu-intel-openvino:8000/v1
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  moodle-ia-mcp:
    build:
      context: ./mcp-servers/moodle-ia-mcp
      dockerfile: Dockerfile
    image: moodle-ia-mcp:latest
    container_name: moodle-ia-mcp
    restart: unless-stopped
    ports:
      - "8097:8097"
    environment:
      - MOODLE_URL=https://moodle.neuropedialab.org
      - MOODLE_TOKEN=${MOODLE_TOKEN:?define MOODLE_TOKEN en .env}
      - INTEL_OPENVINO_URL=http://ia-gpu-intel-openvino:8000/v1
      - INTEL_FALLBACK_URL=http://192.168.0.100:8006/v1
      - DEFAULT_MODEL_INTEL=Qwen3-30B-A3B-Instruct-2507-int4-ov
      - LLM_TIMEOUT=900
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # Moodle Course Studio - frontend de configuracion y ejecucion del pipeline
  # de creacion de cursos (moodle-ia-mcp + IA local). UI en :8098.
  moodle-course-studio:
    build:
      context: ./moodle-course-studio
      dockerfile: Dockerfile
    image: moodle-course-studio:latest
    container_name: moodle-course-studio
    restart: unless-stopped
    ports:
      - "8098:8098"
    environment:
      - MCP_URL=http://moodle-ia-mcp:8097/mcp
      - MOODLE_PUBLIC_URL=https://moodle.neuropedialab.org
      - CALL_TIMEOUT=1800
    volumes:
      - ./moodle-course-studio/data:/data/jobs
    depends_on:
      - moodle-ia-mcp
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # ==========================================
  # DOCKER-AGENT (runner de agentes cagent)
  # CLI, no servicio: `profiles: ["agent"]` evita que arranque con `up -d`.
  #   docker compose run --rm docker-agent "pregunta"
  #   docker compose run --rm docker-agent            # TUI
  # Wrapper: ~/.local/bin/docker-agent.
  # Genérico: NO lleva Zotero. Perfil por defecto /configs/default.yaml con las
  # herramientas nativas de cagent (shell, filesystem, fetch, think).
  # network_mode: host porque los modelos escuchan en loopback del host
  # (OVMS :8006, RX480 .80:1237, LM Studio :1234) y cagent rechaza MCP remoto en
  # direcciones privadas.
  # ==========================================
  docker-agent:
    profiles: ["agent"]
    build:
      context: /home/arkantu/workspace/docker-agent
      args:
        CAGENT_VERSION: ${CAGENT_VERSION:-latest}
        ZOTERO_MCP_VERSION: ${ZOTERO_MCP_VERSION:-0.15.1}
        UID: ${UID:-1000}
        GID: ${GID:-1000}
    image: docker-agent:local
    container_name: docker-agent
    network_mode: host
    working_dir: /workspace
    environment:
      - TZ=Europe/Madrid
      - AGENT_CONFIG=${AGENT_CONFIG:-/configs/default.yaml}
    volumes:
      - /home/arkantu/workspace/docker-agent/configs:/configs:ro
      - /home/arkantu/workspace/docker-agent/integrations:/integrations:ro
      # el agente trabaja sobre el workspace del host y deja sus salidas en out/
      - /home/arkantu/workspace:/workspace
      - /home/arkantu/workspace/docker-agent/out:/out
      # historial de sesiones de cagent (para depurar turnos y tool calls)
      - /home/arkantu/.local/share/docker-agent/cagent:/home/agent/.cagent
    stdin_open: true
    tty: true

  # Integración Zotero del runner (opt-in, NO es el perfil por defecto). Es la pieza
  # donde enganchará el plugin de Zotero cuando se enrute al cagent.
  #   docker compose --profile agent-zotero run --rm docker-agent-zotero "..."
  docker-agent-zotero:
    profiles: ["agent-zotero"]
    image: docker-agent:local
    container_name: docker-agent-zotero
    network_mode: host
    working_dir: /workspace
    environment:
      - TZ=Europe/Madrid
      - AGENT_CONFIG=${AGENT_CONFIG:-/integrations/zotero/zotero.yaml}
      - ZOTERO_LOCAL=true
      # Sin esto FastMCP pinta su banner ASCII en stdout y rompe el stdio JSON-RPC
      # del MCP de Zotero: el agente se queda colgado sin error.
      - FASTMCP_SHOW_SERVER_BANNER=false
      - FASTMCP_CHECK_FOR_UPDATES=off
      - ZOTERO_MCP_TOOLSETS=${ZOTERO_MCP_TOOLSETS:-semantic}
    volumes:
      - /home/arkantu/workspace/docker-agent/configs:/configs:ro
      - /home/arkantu/workspace/docker-agent/integrations:/integrations:ro
      - /home/arkantu/.config/zotero-mcp:/home/agent/.config/zotero-mcp
      - /home/arkantu/Zotero:/home/agent/Zotero:ro
      - /home/arkantu/workspace:/workspace
      - /home/arkantu/workspace/docker-agent/out:/out
      - /home/arkantu/.local/share/docker-agent/cagent:/home/agent/.cagent
    stdin_open: true
    tty: true

  # ==========================================
  # IA-GPU-INTEL-OPENVINO (OpenVINO GenAI)
  # Servidor OpenVINO GenAI nativo (puerto 8006) compatible OpenAI API
  # Usa Intel Arc iGPU Xe2 128EU via Level-Zero
  # Accesible desde LM Studio Desktop via plugin openvino-genai-bridge
  # Panel de administracion GPU en /admin
  # ==========================================
  ia-gpu-intel-openvino:
    image: openvino/model_server:latest-gpu
    container_name: ia-gpu-intel-openvino
    restart: unless-stopped
    shm_size: "8gb"
    mem_limit: 44g
    memswap_limit: 44g
    ports:
      - "8006:8000"
    ipc: host
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    devices:
      # Solo el iGPU Intel (00:02.0) + NPU. (Los nodos de la RX480 se retiraron
      # el 2026-10-23 al quitar la GPU del sistema.)
      # by-path: estable por PCI (la reenumeracion del kernel cambia cardN entre
      # arranques; incluso hubo boots sin card0).
      - source: /dev/dri/by-path/pci-0000:00:02.0-card
        target: /dev/dri/card0
        permissions: rwm
      - source: /dev/dri/by-path/pci-0000:00:02.0-render
        target: /dev/dri/renderD128
        permissions: rwm
      - /dev/accel/accel0:/dev/accel/accel0
    group_add:
      - "44"
      - "992"
    volumes:
      - /home/arkantu/produccion/openvino-models/.openvino-ir:/models:rw
      - ov_cache:/tmp/ov_cache
    command:
      - --config_path
      - /models/config.json
      - --rest_port
      - "8000"
      - --port
      - "9000"
      - --log_level
      - INFO
    environment:
      - ONEAPI_DEVICE_SELECTOR=level_zero:0
      - ZES_ENABLE_SYSMAN=1
      - ZE_AFFINITY_MASK=0
      - UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS=1
      - SYCL_PI_LEVEL_ZERO_USM_RESIDENT=1
      - NEOReadDebugKeys=1
      - OverrideGpuAddressSpace=48
      - DisableImplicitScaling=0
      - IGC_EnableDPEmulation=0
      - MESA_VK_DEVICE_SELECT=8086:7d51!
      - GGML_VK_VISIBLE_DEVICES=0
      - OMP_NUM_THREADS=16
      - KMP_AFFINITY=granularity=fine,compact,1,0
      - NPU_PLATFORM=3720
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # Open WebUI - Frontend unificado para los backends GPU
  # Expone dos conexiones OpenAI-compatible:
  #   1. ia-gpu-intel-openvino (Intel Arc / OpenVINO GenAI) -> http://ia-gpu-intel-openvino:8000
  # Ambos backends no requieren API key real; usamos un placeholder "ollama".
  # Los tags y prefix_id permiten distinguir los modelos de cada GPU en la UI.
  # ==========================================
