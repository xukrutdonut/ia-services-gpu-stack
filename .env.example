# === Compose project name ===
COMPOSE_PROJECT_NAME=ia-services-stack

# === Hermes WebUI (Linux, red host) ===
# Los valores por defecto usan ${HOME}/.hermes y ${HOME}/workspace.
# HERMES_HOME=/ruta/absoluta/.hermes
# HERMES_WORKSPACE=/ruta/absoluta/workspace
HERMES_UID=1000
HERMES_GID=1000
HERMES_WEBUI_HOST=127.0.0.1
HERMES_WEBUI_PORT=8787
# Obligatoria antes de exponer HERMES_WEBUI_HOST=0.0.0.0; introducir localmente.
HERMES_WEBUI_PASSWORD=
HERMES_WEBUI_IMAGE=ghcr.io/nesquena/hermes-webui:0.52.666
HERMES_AGENT_REF=0ea6ea941aee31b20fffeb6dfa0d0f29f4370e2e

# === Dify (postgres/redis/weaviate) ===
DB_USERNAME=postgres
DB_PASSWORD=changeme
REDIS_PASSWORD=changeme
WEAVIATE_API_KEY=changeme
SECRET_KEY=changeme
PLUGIN_DAEMON_KEY=changeme
PLUGIN_DIFY_INNER_API_KEY=changeme
SANDBOX_API_KEY=dify-sandbox

# === Dify URLs ===
CONSOLE_API_URL=http://localhost:5100
CONSOLE_WEB_URL=http://localhost:3100
SERVICE_API_URL=http://localhost:5100
APP_API_URL=http://localhost:5100
APP_WEB_URL=http://localhost:3100

# Moodle Web Service token (moodle-ia-mcp)
MOODLE_TOKEN=tu_token_aqui
