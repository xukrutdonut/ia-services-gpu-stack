networks:
  ia-routing-stack:
    driver: bridge
volumes:
  openvino-models: null
  ov_cache: null
  lms-config: null
  open-webui-data: null
  open-terminal-data: null
services:
  # ==========================================
  # SECCIÓN MCP (Model Context Protocol Servers)
  # Transporte: streamable-http (compatible nativo con Open WebUI >= 0.11)
  # ==========================================

  # Open Terminal - servidor REST oficial de open-webui/open-terminal
  # Integracion nativa en Open WebUI (Admin Settings -> Integrations -> Open Terminal)
  # Da barra lateral con file browser, upload/download, editor y ejecucion de comandos
  open-terminal:
    image: ghcr.io/open-webui/open-terminal:slim
    container_name: open-terminal
    restart: unless-stopped
    ports:
      - "8003:8000"
    environment:
      - OPEN_TERMINAL_API_KEY=XMaT-ey_ekoJ9zHJITPpNQilqi_o9Sqy7G4q0jo1gyE
      - OPEN_TERMINAL_FILE_BROWSER_ROOT=/workspace
    volumes:
      - open-terminal-data:/home/user
      - /home/arkantu/workspace:/workspace
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  fetch-mcp:
    build:
      context: ./mcp-servers/fetch-mcp
      dockerfile: Dockerfile
    image: fetch-mcp:latest
    container_name: fetch-mcp
    restart: unless-stopped
    ports:
      - "8095:8095"
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # SearXNG - metabuscador (backend de busqueda para searxng-mcp y para el
  # backend `searxng` de Hermes en config.yaml). Puerto host 8085 -> 8080.
  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    restart: unless-stopped
    ports:
      - "8085:8080"
    volumes:
      - ./searxng/settings.yml:/etc/searxng/settings.yml:ro
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # MCP server de busqueda web (tool `search_web`). Usa SearXNG interno y
  # cae a DDGS si SearXNG no responde. Transporte SSE en /sse (patron
  # consumido por LM Studio y por mcp-bridge/oi_mcp_proxy.py).
  searxng-mcp:
    build:
      context: ./mcp-servers/searxng-mcp
      dockerfile: Dockerfile
    image: searxng-mcp:latest
    container_name: searxng-mcp
    restart: unless-stopped
    ports:
      - "8092:8092"
    environment:
      - SEARXNG_URL=http://searxng:8080
    depends_on:
      - searxng
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  nano-fs-tools-mcp:
    build:
      context: ./mcp-servers/nano-fs-tools-mcp
      dockerfile: Dockerfile
    image: nano-fs-tools-mcp:latest
    container_name: nano-fs-tools-mcp
    restart: unless-stopped
    ports:
      - "8096:8096"
    volumes:
      - /home/arkantu/workspace:/workspace
    environment:
      - WORKSPACE_DIR=/workspace
      - OPENVINO_GENAI_URL=http://ia-gpu-intel-openvino:8000/v1
      - INTEL_OPENVINO_URL=http://ia-gpu-intel-openvino:8000/v1
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  moodle-ia-mcp:
    build:
      context: ./mcp-servers/moodle-ia-mcp
      dockerfile: Dockerfile
    image: moodle-ia-mcp:latest
    container_name: moodle-ia-mcp
    restart: unless-stopped
    ports:
      - "8097:8097"
    environment:
      - MOODLE_URL=https://moodle.neuropedialab.org
      - MOODLE_TOKEN=734d7e02718f02570a70bdbc87698c78
      - INTEL_OPENVINO_URL=http://ia-gpu-intel-openvino:8000/v1
      - INTEL_FALLBACK_URL=http://192.168.0.100:8006/v1
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # ==========================================
  # IA-GPU-INTEL-OPENVINO (OpenVINO GenAI)
  # Servidor OpenVINO GenAI nativo (puerto 8006) compatible OpenAI API
  # Usa Intel Arc iGPU Xe2 128EU via Level-Zero
  # Accesible desde LM Studio Desktop via plugin openvino-genai-bridge
  # Panel de administracion GPU en /admin
  # ==========================================
  ia-gpu-intel-openvino:
    image: openvino/model_server:latest-gpu
    container_name: ia-gpu-intel-openvino
    restart: unless-stopped
    shm_size: "8gb"
    mem_limit: 44g
    memswap_limit: 44g
    ports:
      - "8006:8000"
    ipc: host
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    devices:
      # Solo el iGPU Intel (00:02.0) + NPU. (Los nodos de la RX480 se retiraron
      # el 2026-10-23 al quitar la GPU del sistema.)
      # by-path: estable por PCI (la reenumeracion del kernel cambia cardN entre
      # arranques; incluso hubo boots sin card0).
      - source: /dev/dri/by-path/pci-0000:00:02.0-card
        target: /dev/dri/card0
        permissions: rwm
      - source: /dev/dri/by-path/pci-0000:00:02.0-render
        target: /dev/dri/renderD128
        permissions: rwm
      - /dev/accel/accel0:/dev/accel/accel0
    group_add:
      - "44"
      - "992"
    volumes:
      - /home/arkantu/produccion/openvino-models/.openvino-ir:/models:rw
      - ov_cache:/tmp/ov_cache
    command:
      - --config_path
      - /models/config.json
      - --rest_port
      - "8000"
      - --port
      - "9000"
      - --log_level
      - INFO
    environment:
      - ONEAPI_DEVICE_SELECTOR=level_zero:0
      - ZES_ENABLE_SYSMAN=1
      - ZE_AFFINITY_MASK=0
      - UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS=1
      - SYCL_PI_LEVEL_ZERO_USM_RESIDENT=1
      - NEOReadDebugKeys=1
      - OverrideGpuAddressSpace=48
      - DisableImplicitScaling=0
      - IGC_EnableDPEmulation=0
      - MESA_VK_DEVICE_SELECT=8086:7d51!
      - GGML_VK_VISIBLE_DEVICES=0
      - OMP_NUM_THREADS=16
      - KMP_AFFINITY=granularity=fine,compact,1,0
      - NPU_PLATFORM=3720
    networks:
      - ia-routing-stack
    deploy:
      placement:
        constraints:
        - node.hostname == khazad-dum

  # Open WebUI - Frontend unificado para los backends GPU
  # Expone dos conexiones OpenAI-compatible:
  #   1. ia-gpu-intel-openvino (Intel Arc / OpenVINO GenAI) -> http://ia-gpu-intel-openvino:8000
  # Ambos backends no requieren API key real; usamos un placeholder "ollama".
  # Los tags y prefix_id permiten distinguir los modelos de cada GPU en la UI.
  # ==========================================
