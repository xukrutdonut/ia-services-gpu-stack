# Malla de inferencia - LiteLLM como unica puerta OpenAI-compatible (:4000)
# Carriles: V100/ninfer-serve :8090 (principal, 135 tok/s decode, 262k ctx)
#           | Arc iGPU/OVMS :8006 (aux + respaldo, 23 tok/s)
#           | Hailo-8L .80:8089 (OCR + CLIP imagen) | NPU :8012 (embeddings)
#
# TOPOLOGIA (2026-11-09): TODOS los alias de texto (chat, fast, deep, lms27,
# worker-big, ninfer) apuntan al motor ninfer de la V100. llama-swap/LM Studio
# :1234 ya no sirve nada: ninfer ocupa 28 de los 32 GB de la V100 y no cabe un
# segundo motor. `vision` queda apuntando a :1234 hasta que exista un VLM.
#
# Prioridad = VELOCIDAD (bench 2026-11-08, prompt 2k unico, temp 0):
#   V100 35B-A3B  prefill 725 tok/s | decode 89-94 tok/s | TTFT 2,1s con 2k de contexto
#   Arc Qwen3-30B prefill 213 tok/s | decode 23 tok/s  | TTFT 8,8s con 2k de contexto
#   V100 27B      decode 32 tok/s   (denso: mas lento que el MoE 35B)
#   V100 4B       decode 110 tok/s  (calidad baja, solo para tareas aux)
# => `chat` va a la V100. La Arc queda como `arc` (tareas de fondo de Open WebUI y
#    respaldo cuando la V100 esta cargando otro modelo o esta enfriada).
#
# Cola y backpressure:
#   - max_parallel_requests limita la concurrencia real por backend; el resto ESPERA (cola FIFO).
#   - rpm actua de valvula: pasado el limite LiteLLM responde 429 en vez de encolar sin fin.
#   - cooldown_time + allowed_fails: un backend que falla sale de rotacion 60s y entra el fallback.
model_list:
  # ============ carril V100 (LM Studio :1234) - rapido, contexto largo ============
  - model_name: chat
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 60
      timeout: 900
    model_info:
      gpu: v100
      engine: ninfer
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  # Alias con el nombre crudo del GGUF: los clientes que pedian el modelo a
  # LM Studio (:1234) lo piden aqui y ya no disparan una carga JIT imposible
  # en la V100 (el GGUF es el mismo fichero que sirve llama-swap).
  - model_name: qwen3.6-35b-a3b-mtp
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 60
      timeout: 900
    model_info:
      gpu: v100
      engine: ninfer
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  - model_name: fast
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 120
      timeout: 300
    model_info:
      gpu: v100
      engine: ninfer
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  - model_name: deep
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 20
      timeout: 900
    model_info:
      gpu: v100
      engine: ninfer
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  - model_name: vision
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 20
      timeout: 900
    model_info:
      gpu: v100
      engine: ninfer
      vision: true
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  - model_name: lms27
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 20
      timeout: 900
    model_info:
      gpu: v100
      engine: ninfer
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  # Fan-out: mismo 35B de la V100 (sin swap de modelo), 4 en paralelo
  - model_name: worker-big
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 120
      timeout: 600
    model_info:
      gpu: v100
      engine: ninfer
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  # ============ carril ninfer (motor nativo ninfer-serve, host :8090) ============
  - model_name: ninfer
    litellm_params:
      model: openai/ninfer
      api_base: http://host.docker.internal:8090/v1
      api_key: "sk-mesh"
      extra_body: {reasoning_effort: none}
      max_parallel_requests: 2
      rpm: 60
      timeout: 900
    model_info:
      gpu: v100
      engine: ninfer
      vision: true
      context_length: 262144
      max_input_tokens: 253952
      max_output_tokens: 8192

  # ============ carril Arc iGPU (OVMS :8006) - siempre encendido ============
  # `arc` = tareas de fondo de Open WebUI (titulo, tags, follow-up) y respaldo de `chat`
  - model_name: arc
    litellm_params:
      model: openai/Qwen3-30B-A3B-Instruct-2507-int4-ov
      api_base: http://ia-gpu-intel-openvino:8000/v1
      api_key: "sk-mesh"
      max_parallel_requests: 3
      rpm: 180
      timeout: 300
    model_info:
      gpu: arc-igpu
      lane: aux

  - model_name: worker
    litellm_params:
      model: openai/Qwen3-30B-A3B-Instruct-2507-int4-ov
      api_base: http://ia-gpu-intel-openvino:8000/v1
      api_key: "sk-mesh"
      max_parallel_requests: 2
      rpm: 120
      timeout: 300
    model_info:
      gpu: arc-igpu
      lane: parallel

  - model_name: embed
    litellm_params:
      model: openai/qwen3-embedding-0.6b-int4-ov
      api_base: http://ia-gpu-intel-openvino:8000/v1
      api_key: "sk-mesh"
      max_parallel_requests: 4
      rpm: 600
      timeout: 120
    model_info:
      gpu: arc-igpu
      lane: embed

  # Misma familia de modelo que `embed`, pero compilada para la NPU
  # (systemd --user npu-embeddings.service en :8012). La NPU usa pooling
  # LAST-TOKEN (el correcto para Qwen3) y la iGPU CLS, asi que los vectores
  # NO son intercambiables entre embed y embed-npu: no poner fallback cruzado.
  - model_name: embed-npu
    litellm_params:
      model: openai/qwen3-embedding-0.6b-int4-ov
      api_base: http://host.docker.internal:8012/v1
      api_key: "sk-mesh"
      max_parallel_requests: 1   # un unico stream en la NPU
      rpm: 120
      timeout: 120
    model_info:
      gpu: intel-npu
      lane: embed

  # Embeddings de IMAGEN en el Hailo-8L del Pi5 (.80). No es texto: el input son
  # imagenes en data URI base64, URL http(s) o base64 suelto, y devuelve 640 d
  # (CLIP ResNet-50x4, ~195 ms/imagen). El tower de texto no existe para Hailo-8L,
  # asi que sirve para similitud imagen-imagen, no para buscar con palabras.
  - model_name: embed-vision
    litellm_params:
      model: openai/clip-resnet-50x4-hailo
      api_base: http://192.168.0.80:8089/v1
      api_key: "sk-mesh"
      max_parallel_requests: 1
      rpm: 120
      timeout: 180
    model_info:
      gpu: hailo-8l
      lane: embed

  # OCR del Hailo-8L como "chat": se le pasa la imagen en content[].image_url y
  # devuelve el texto extraido. No conversa; sin imagen responde 400.
  - model_name: ocr
    litellm_params:
      model: openai/ocr-hailo-8l
      api_base: http://192.168.0.80:8089/v1
      api_key: "sk-mesh"
      max_parallel_requests: 1
      rpm: 60
      timeout: 600
    model_info:
      gpu: hailo-8l
      lane: ocr

  - model_name: embed-lite
    litellm_params:
      model: openai/nomic-embed-text-v1.5-ov
      api_base: http://ia-gpu-intel-openvino:8000/v1
      api_key: "sk-mesh"
      max_parallel_requests: 4
      rpm: 600
      timeout: 120
    model_info:
      gpu: arc-igpu
      lane: embed

router_settings:
  routing_strategy: least-busy
  num_retries: 1
  timeout: 900
  # ninfer es el UNICO carril de la V100: con allowed_fails=1 un 400 puntual
  # (p.ej. prompt gigante) lo sacaba de rotacion 60s y todo daba 429.
  allowed_fails: 5
  cooldown_time: 30
  # TODOS los alias (texto y vision) apuntan al motor ninfer (:8090). El respaldo
  # real es la iGPU Intel (arc/worker, OVMS). `vision` no tiene fallback: la iGPU no
  # ve imagenes, asi que el error debe verse en vez de degradarse en silencio.
  fallbacks:
    - chat: ["arc"]
    - fast: ["worker"]
    - deep: ["arc"]
    - lms27: ["arc"]
    - worker-big: ["worker"]
    - worker: ["arc"]
    - ninfer: ["arc"]

litellm_settings:
  drop_params: true
  request_timeout: 900
  set_verbose: false

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  store_model_in_db: false
