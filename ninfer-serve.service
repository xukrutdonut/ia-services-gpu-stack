# /etc/systemd/system/ninfer-serve.service
# ninfer engine (V100) en contenedor ninfer-serve :8090. Runtime autocontenido
# ninfer-v100:bench; binarios dentro de la imagen, /models montado desde
# ~/produccion/ninfer-v100/models. Default = Qwen3.6-35B-A3B NVFP4 v3 (2026-11-11).
#
# El stop NO usa `pgrep -f ninfer-serve`: ese patron coincide con la cmdline del propio
# `sh -c` que lo ejecuta y el proceso se mata a si mismo (el arranque moria con status=143).
# El script ancla el patron a ^/build/apps/ninfer-serve.
[Unit]
Description=ninfer engine (V100) en contenedor ninfer-serve :8090
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStartPre=/bin/sh -c 'docker start ninfer-serve >/dev/null 2>&1 || true; for i in $(seq 1 60); do docker exec ninfer-serve true 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/home/arkantu/produccion/ia-services-stack/ninfer-serve.sh
ExecStop=/home/arkantu/produccion/ia-services-stack/ninfer-serve.sh stop

[Install]
WantedBy=multi-user.target
